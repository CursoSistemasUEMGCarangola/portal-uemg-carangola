# Supabase Configuration (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://sua-instancia.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-publishable-key-opcional

# Chave de Serviço Restrita (Uso exclusivo em scripts seguros de administração/seed)
# NUNCA exponha esta chave com prefixo NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-privada

# URLs de Conexão com Banco de Dados PostgreSQL (Pooler e Direct)
DATABASE_URL=postgresql://postgres.instancia:senha@pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:senha@db.instancia.supabase.co:5432/postgres


# Chave Pública Criptográfica do Gabinete da Direção (Envelope Encryption)
NEXT_PUBLIC_DIRECTION_ENCRYPTION_KEY=chave-publica-rsa-4096-em-spki-pem-ou-base64

# Configurações de PWA & Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=sua-chave-publica-vapid
VAPID_PRIVATE_KEY=sua-chave-privada-vapid
VAPID_SUBJECT=mailto:contato.carangola@uemg.br
